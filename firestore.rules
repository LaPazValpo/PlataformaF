rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -- Funciones de Ayuda de Seguridad --
    
    // Devuelve true si el usuario ha iniciado sesión.
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Devuelve true si el usuario que hace la solicitud es el dueño del documento.
    function isOwner(userId) {
        return request.auth.uid == userId;
    }
    
    // Obtiene el rol del usuario desde su documento en la colección 'users'.
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Devuelve true si el usuario tiene un rol específico.
    function isRole(role) {
        return isSignedIn() && getRole() == role;
    }

    // Devuelve true si el usuario tiene uno de los roles en la lista.
    function isOneOfRoles(roles) {
        return isSignedIn() && getRole() in roles;
    }
    
    // -- Reglas por Colección --

    match /users/{userId} {
      // Un usuario autenticado puede leer su propio perfil (CRÍTICO para que getRole() funcione).
      // Un Administrador puede leer cualquier perfil.
      allow read: if (isSignedIn() && isOwner(userId)) || isRole('Administrador');
      
      // Solo el dueño del perfil o un Administrador pueden escribir.
      allow write: if isOwner(userId) || isRole('Administrador');
    }
    
    match /prospects/{prospectId} {
      // Cualquiera puede crear un prospecto (para el formulario de la landing).
      allow create: if true;
      // Solo roles autorizados pueden leer y modificar prospectos.
      allow read, update, delete: if isOneOfRoles(['Administrador', 'Vendedor', 'Vendedor Senior']);
    }
    
    match /proposals/{proposalId} {
      allow read, write: if isOneOfRoles(['Administrador', 'Vendedor', 'Vendedor Senior']);
    }
    
    match /sales/{saleId} {
      allow read, write: if isOneOfRoles(['Administrador', 'Vendedor', 'Vendedor Senior']);
    }
    
    match /clients/{clientId} {
      allow read, write: if isOneOfRoles(['Administrador', 'Vendedor', 'Vendedor Senior']);
    }
    
    match /sellers/{sellerId} {
       // Solo roles autorizados pueden ver la información de los vendedores.
      allow read: if isOneOfRoles(['Administrador', 'Vendedor', 'Vendedor Senior']);
      // Solo el administrador puede crear, actualizar o eliminar vendedores.
      allow write: if isRole('Administrador');
    }
    
    // --- Colecciones Públicas y de Contenido ---

    match /servicePacks/{packId} {
      // Cualquiera puede ver los paquetes de servicios.
      allow read: if true;
      // Solo el Administrador puede modificarlos.
      allow write: if isRole('Administrador');
    }
    
    match /virtualChapelPlans/{planId} {
      // Cualquiera puede ver los planes de capilla virtual.
      allow read: if true;
      allow write: if isRole('Administrador');
    }
    
    match /individualServices/{serviceId} {
      // Cualquiera puede ver los servicios individuales.
      allow read: if true;
      allow write: if isRole('Administrador');
    }
    
    match /virtualTombs/{tombId} {
      // Cualquiera puede ver las tumbas virtuales.
      allow read: if true;
      allow write: if isRole('Administrador');
    }

    match /testimonials/{testimonialId} {
       // Cualquiera puede leer los testimonios.
      allow read: if true;
      allow write: if isRole('Administrador');
    }

    // --- Colecciones solo para Administradores ---
    
    match /inventory/{itemId} {
      // Solo el administrador puede gestionar el inventario.
      allow read, write: if isRole('Administrador');
    }
  }
}
