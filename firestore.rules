rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -- Funciones de Ayuda de Seguridad --
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
        return request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOneOfRoles(roles) {
        return isSignedIn() && getUserRole() in roles;
    }
    
    // -- Reglas por Colección --

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOneOfRoles(['Administrador']);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isOneOfRoles(['Administrador']);
    }
    
    match /prospects/{prospectId} {
      allow create: if true;
      allow read, update, delete: if isOneOfRoles(['Administrador', 'Vendedor', 'Vendedor Senior']);
    }
    
    match /proposals/{proposalId} {
      allow read: if true;
      allow write: if isOneOfRoles(['Administrador', 'Vendedor', 'Vendedor Senior']);
    }
    
    match /sales/{saleId} {
      allow read, write: if isOneOfRoles(['Administrador', 'Vendedor', 'Vendedor Senior']);
    }
    
    match /clients/{clientId} {
      // CUALQUIERA (visitante no autenticado) puede crear un nuevo registro de cliente.
      allow create: if true; 
      // PERO solo el personal autenticado puede leer, actualizar o borrar clientes.
      allow read, update, delete: if isOneOfRoles(['Administrador', 'Vendedor', 'Vendedor Senior']);
    }
    
    match /sellers/{sellerId} {
      allow read: if isSignedIn();
      allow write: if isOneOfRoles(['Administrador']);
    }
    
    // --- Colecciones Públicas y de Contenido (solo editables por Admin) ---

    match /servicePacks/{packId} {
      allow read: if true;
      allow write: if isOneOfRoles(['Administrador']);
    }
    
    match /virtualChapelPlans/{planId} {
      allow read: if true;
      allow write: if isOneOfRoles(['Administrador']);
    }
    
    match /individualServices/{serviceId} {
      allow read: if true;
      allow write: if isOneOfRoles(['Administrador']);
    }
    
    match /virtualTombs/{tombId} {
      allow read: if true;
      allow write: if isOneOfRoles(['Administrador']);
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isOneOfRoles(['Administrador']);
    }

    // --- Colecciones solo para Administradores ---
    
    match /inventory/{itemId} {
      allow read, write: if isOneOfRoles(['Administrador']);
    }
  }
}
