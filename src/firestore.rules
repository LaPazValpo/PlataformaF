rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -- Funciones de Ayuda de Seguridad --
    
    // Devuelve true si el usuario ha iniciado sesión.
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Devuelve true si el usuario que hace la solicitud es el dueño del documento.
    function isOwner(userId) {
        return request.auth.uid == userId;
    }

    // Devuelve el rol del usuario desde su documento en la colección 'users'.
    // IMPORTANTE: Esta función solo se puede usar de forma fiable en reglas "get", "write", "update", "delete".
    // NO FUNCIONARÁ de forma fiable en reglas "list" sin condiciones adicionales.
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Devuelve true si el usuario tiene un rol específico.
    function isRole(role) {
        return isSignedIn() && getRole() == role;
    }
    
    function isOneOfRoles(roles) {
      return isSignedIn() && getRole() in roles;
    }
    
    // -- Reglas por Colección --

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isRole('Administrador');
      // Un usuario puede crear su propio perfil. Un administrador puede actualizar el de otros.
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isRole('Administrador');
    }
    
    match /prospects/{prospectId} {
      allow create: if true;
      allow read, update, delete: if isOneOfRoles(['Administrador', 'Vendedor', 'Vendedor Senior']);
    }
    
    match /proposals/{proposalId} {
      // La propuesta es pública para el cliente, pero solo editable por el personal.
      allow read: if true;
      allow write: if isOneOfRoles(['Administrador', 'Vendedor', 'Vendedor Senior']);
    }
    
    match /sales/{saleId} {
      allow read, write: if isOneOfRoles(['Administrador', 'Vendedor', 'Vendedor Senior']);
    }
    
    match /clients/{clientId} {
      allow create: if true;
      allow read, write: if isOneOfRoles(['Administrador', 'Vendedor', 'Vendedor Senior']);
    }
    
    match /sellers/{sellerId} {
      allow read: if isSignedIn();
      allow write: if isRole('Administrador');
    }
    
    // --- Colecciones Públicas y de Contenido ---

    match /servicePacks/{packId} {
      allow read: if true;
      allow write: if isRole('Administrador');
    }
    
    match /virtualChapelPlans/{planId} {
      allow read: if true;
      allow write: if isRole('Administrador');
    }
    
    match /individualServices/{serviceId} {
      allow read: if true;
      allow write: if isRole('Administrador');
    }
    
    match /virtualTombs/{tombId} {
      allow read: if true;
      allow write: if isRole('Administrador');
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isRole('Administrador');
    }

    // --- Colecciones solo para Administradores ---
    
    match /inventory/{itemId} {
      allow read, write: if isRole('Administrador');
    }
  }
}
